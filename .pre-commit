#!/usr/bin/env bash
# .pre-commit — Local git pre-commit hook
# ─────────────────────────────────────────────────────────────────────────────
# PURPOSE: Catch mistakes before they reach GitHub.
# Checks: secrets in staged files, Terraform formatting, K8s manifest validation.
#
# INSTALL:
#   cp .pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# OR use the Makefile target:
#   make install-hooks
#
# BYPASS (emergency only):
#   git commit --no-verify -m "your message"
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

FAILED=0

echo "Running pre-commit checks..."

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 1: Detect AWS credentials and secrets in staged files
# ─────────────────────────────────────────────────────────────────────────────
echo -n "  Checking for secrets... "

# Get list of staged files (not deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
  # Check for AWS Access Key patterns (AKIA... is always 20 chars starting with AKIA)
  if echo "$STAGED_FILES" | xargs grep -l "AKIA[0-9A-Z]\{16\}" 2>/dev/null | grep -q .; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}  ✗ AWS Access Key detected in staged files!${NC}"
    echo "    Run: git diff --cached | grep -n 'AKIA'"
    FAILED=1
  # Check for AWS Secret Key patterns (40 char base64-looking strings after key indicators)
  elif echo "$STAGED_FILES" | xargs grep -lE "(aws_secret|secret_key|SECRET_KEY)\s*[=:]\s*['\"]?[A-Za-z0-9+/]{40}" 2>/dev/null | grep -q .; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}  ✗ AWS Secret Key pattern detected!${NC}"
    FAILED=1
  # Check for .tfvars files being committed
  elif echo "$STAGED_FILES" | grep -qE "\.tfvars$" | grep -v "example"; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}  ✗ .tfvars file staged for commit! Contains real values?${NC}"
    echo "    Run: git reset HEAD terraform/*.tfvars"
    FAILED=1
  # Check for kubeconfig files
  elif echo "$STAGED_FILES" | grep -qE "kubeconfig|\.kube/config"; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}  ✗ Kubeconfig file staged! Gives full cluster access.${NC}"
    FAILED=1
  else
    echo -e "${GREEN}OK${NC}"
  fi
else
  echo -e "${GREEN}OK (no staged files)${NC}"
fi

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 2: Terraform formatting
# ─────────────────────────────────────────────────────────────────────────────
TF_STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep "\.tf$" || true)

if [ -n "$TF_STAGED" ]; then
  echo -n "  Checking Terraform formatting... "
  if command -v terraform &>/dev/null; then
    if ! terraform fmt -check -recursive terraform/ &>/dev/null; then
      echo -e "${YELLOW}WARNING${NC}"
      echo -e "${YELLOW}  ⚠ Terraform files not properly formatted. Run: terraform fmt -recursive terraform/${NC}"
      # Warning only — doesn't block commit
    else
      echo -e "${GREEN}OK${NC}"
    fi
  else
    echo -e "${YELLOW}SKIPPED (terraform not installed)${NC}"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 3: Kubernetes manifest validation
# ─────────────────────────────────────────────────────────────────────────────
K8S_STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep "k8s/.*\.yaml$" || true)

if [ -n "$K8S_STAGED" ]; then
  echo -n "  Validating K8s manifests... "
  if command -v kubeconform &>/dev/null; then
    if ! echo "$K8S_STAGED" | xargs kubeconform \
        -strict \
        -ignore-missing-schemas \
        -summary 2>/dev/null; then
      echo -e "${RED}FAILED${NC}"
      echo -e "${RED}  ✗ Kubernetes manifest validation failed!${NC}"
      echo "    Run: kubeconform -strict k8s/**/*.yaml"
      FAILED=1
    else
      echo -e "${GREEN}OK${NC}"
    fi
  elif command -v kubectl &>/dev/null; then
    # Fallback: kubectl dry-run (requires cluster connection)
    FAILED_MANIFESTS=0
    for f in $K8S_STAGED; do
      if ! kubectl apply --dry-run=client -f "$f" &>/dev/null; then
        FAILED_MANIFESTS=$((FAILED_MANIFESTS+1))
      fi
    done
    if [ "$FAILED_MANIFESTS" -gt 0 ]; then
      echo -e "${RED}FAILED ($FAILED_MANIFESTS manifests)${NC}"
      FAILED=1
    else
      echo -e "${GREEN}OK${NC}"
    fi
  else
    echo -e "${YELLOW}SKIPPED (kubeconform/kubectl not installed)${NC}"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 4: No 'latest' image tags in K8s manifests
# ─────────────────────────────────────────────────────────────────────────────
if [ -n "$K8S_STAGED" ]; then
  echo -n "  Checking for 'latest' image tags... "
  LATEST_FOUND=$(echo "$K8S_STAGED" | xargs grep -n "image:.*:latest" 2>/dev/null || true)
  if [ -n "$LATEST_FOUND" ]; then
    echo -e "${YELLOW}WARNING${NC}"
    echo -e "${YELLOW}  ⚠ 'latest' tag found in manifests (unpinned images risk inconsistency):${NC}"
    echo "$LATEST_FOUND" | head -5
    # Warning only — latest is acceptable for base images during development
  else
    echo -e "${GREEN}OK${NC}"
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# RESULT
# ─────────────────────────────────────────────────────────────────────────────
echo ""
if [ "$FAILED" -eq 0 ]; then
  echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
  exit 0
else
  echo -e "${RED}✗ Pre-commit checks failed. Fix issues above before committing.${NC}"
  echo -e "  Bypass: git commit --no-verify (use only if you know what you're doing)"
  exit 1
fi
