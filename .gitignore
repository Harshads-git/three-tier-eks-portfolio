# ============================================================
# .gitignore — Three-Tier EKS Portfolio
# ============================================================
# Rule: When in doubt, add it here.
# Leaked secrets (AWS keys, K8s tokens) are catastrophic.
# ============================================================

# ============================================================
# Node.js
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnp
.pnp.js
coverage/
build/
dist/
.next/
.cache/

# ============================================================
# Environment variables — NEVER commit real secrets!
# ============================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# ALLOW: example templates (no real values)
!.env.example
!**/.env.example

# ============================================================
# Terraform — CRITICAL: State files contain plaintext secrets!
# ============================================================
.terraform/
.terraform.lock.hcl
# State files — NEVER commit. Always use S3 remote backend.
*.tfstate
*.tfstate.*
*.tfstate.backup
tfplan
tfplan.binary
# Crash logs
crash.log
crash.*.log
# Variable files — contain account IDs, bucket names, etc.
*.tfvars
!terraform.tfvars.example  # ALLOW: template with no real values
# Override files (local development only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ============================================================
# AWS Credentials — NEVER commit!
# ============================================================
.aws/
aws-credentials
credentials
# Common credential file patterns
*_credentials.json
*-credentials.json
aws_access_key*
aws_secret_key*

# ============================================================
# Kubernetes — CRITICAL: kubeconfig gives full cluster access!
# ============================================================
kubeconfig
*.kubeconfig
kubeconfig.yaml
kubeconfig.yml
.kube/
# Decoded secret values
*-decoded.yaml
*-secret-values.yaml

# ============================================================
# Docker
# ============================================================
# Allow .dockerignore files (they're important for builds)
# .dockerignore

# ============================================================
# k6 Load Test Results
# ============================================================
# Test results contain endpoint data — exclude from repo
k6/results/
results/
*.json
# But ALLOW k6 test SCRIPTS (they're code, not data)
!k6/load-tests/*.js

# ============================================================
# Helm
# ============================================================
# Helm release override values (may contain credentials)
*-values-override.yaml
*-values-local.yaml

# ============================================================
# OS Generated Files
# ============================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Windows
ehthumbs.db
Thumbs.db
desktop.ini
# Linux
.directory
# Temporary files
*.tmp
*.temp
*.bak
*.orig

# ============================================================
# IDE / Editors
# ============================================================
# JetBrains (IntelliJ, GoLand, etc.)
.idea/
*.iml
*.iws
# VS Code (allow .vscode/extensions.json for team settings)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# Vim/Emacs
*.swp
*.swo
*~
# Eclipse
.project
.classpath
.settings/

# ============================================================
# Logs and Debugging
# ============================================================
logs/
*.log
*.log.*
npm-debug.log*
pip-log.txt

# ============================================================
# Certificates and Private Keys — NEVER commit!
# ============================================================
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.kube
# JWT secrets
*.jwt

# ============================================================
# Python (for helper scripts)
# ============================================================
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
.python-version

# ============================================================
# Miscellaneous Tools
# ============================================================
infracost-output.json
.checkov.baseline
trivy-report.json
*.sarif
# Terraform plan files (can contain sensitive data)
*.plan
