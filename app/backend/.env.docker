# ─────────────────────────────────────────────────────────────────────────────
# Backend Docker Compose Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is loaded by docker-compose.yml via env_file: (if used)
# OR values are set directly in docker-compose.yml environment: block.
#
# For Docker Compose, "mongo" in MONGO_URI is the Docker service name.
# Docker's internal DNS resolves "mongo" to the mongo container's IP.
#
# This is the compose-specific equivalent of:
#   Local dev:   mongodb://localhost:27017/tasksdb
#   Kubernetes:  mongodb://admin:pass@mongo-service:27017/tasksdb
#
# authSource=admin is required when using MONGO_INITDB_ROOT_USERNAME
# (credentials are stored in the admin database, not the app database)
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://admin:password123@mongo:27017/tasksdb?authSource=admin
