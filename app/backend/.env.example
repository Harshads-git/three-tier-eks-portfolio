# ─────────────────────────────────────────────────────────────────────────────
# Backend Environment Variables — EXAMPLE FILE
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in your actual values in .env (which is gitignored — NEVER commit .env)
#
# KUBERNETES STRATEGY:
# ─────────────────────────────────────────────────────────────────────────────
# In Kubernetes, these values are NOT set from a file. Instead:
#
#   Non-secret values (PORT, NODE_ENV):
#     → Stored in a ConfigMap (k8s/backend/configmap.yaml)
#     → Referenced via: env.valueFrom.configMapKeyRef in deployment.yaml
#
#   Secret values (MONGO_URI):
#     → Stored in a Secret (k8s/mongo/secret.yaml)
#     → Referenced via: env.valueFrom.secretKeyRef in deployment.yaml
#     → K8s Secrets are base64-encoded (not encrypted by default!)
#     → For production: use AWS Secrets Manager + External Secrets Operator
#
# The separation of secrets vs config is a critical K8s security practice.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION (Non-Secret — ConfigMap in K8s)
# ─────────────────────────────────────────────────────────────────────────────

# PORT — The port the Express server listens on.
# K8s Service targetPort MUST match this value.
# See: k8s/backend/service.yaml → spec.ports[].targetPort
PORT=5000

# NODE_ENV — Controls logging verbosity and error detail level.
# Values: development | production | test
# In K8s: Always set to "production" — prevents stack traces in responses.
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (SECRET — K8s Secret, NOT ConfigMap)
# ─────────────────────────────────────────────────────────────────────────────

# MONGO_URI — MongoDB connection string (including credentials).
#
# ⚠️  THIS IS A SECRET. NEVER commit the actual value to git.
# ⚠️  It contains credentials — treat it like a password.
#
# Connection string format:
#   mongodb://<username>:<password>@<host>:<port>/<database>?<options>
#
# Environment-specific values:
#
#   Local (MongoDB running directly):
#     MONGO_URI=mongodb://localhost:27017/tasksdb
#
#   Docker Compose (uses Docker internal DNS):
#     MONGO_URI=mongodb://admin:password@mongo:27017/tasksdb
#     ↑ "mongo" is the service name in docker-compose.yml
#
#   Kubernetes EKS (uses K8s internal DNS):
#     MONGO_URI=mongodb://admin:password@mongo-service.three-tier.svc.cluster.local:27017/tasksdb
#     ↑ Format: <service-name>.<namespace>.svc.cluster.local
#     In K8s, this is set from the Secret, not from a file.
#
#   MongoDB Atlas (cloud-hosted):
#     MONGO_URI=mongodb+srv://user:pass@cluster0.abc123.mongodb.net/tasksdb
#
MONGO_URI=mongodb://localhost:27017/tasksdb

# ─────────────────────────────────────────────────────────────────────────────
# HOW K8s INJECTS THESE VALUES (Reference)
# ─────────────────────────────────────────────────────────────────────────────
#
# In k8s/backend/deployment.yaml:
#
# env:
#   - name: PORT
#     valueFrom:
#       configMapKeyRef:
#         name: backend-config
#         key: PORT
#
#   - name: NODE_ENV
#     valueFrom:
#       configMapKeyRef:
#         name: backend-config
#         key: NODE_ENV
#
#   - name: MONGO_URI
#     valueFrom:
#       secretKeyRef:
#         name: mongo-secret      # k8s/mongo/secret.yaml
#         key: MONGO_URI
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY NOTES
# ─────────────────────────────────────────────────────────────────────────────
#
# Unlike frontend (React) env vars:
#   - Backend env vars are RUNTIME values (not baked at build time)
#   - They are NEVER sent to the browser
#   - Changing them requires only a pod restart, not a rebuild
#   - They CAN contain real secrets (passwords, API keys, tokens)
#
# This is why the three-tier architecture matters:
#   Frontend = no secrets (public JS bundle)
#   Backend  = secrets live here (process.env, never sent to browser)
#   Database = credentials injected via K8s Secret (most sensitive)
#
# For enterprise security:
#   → AWS Secrets Manager + External Secrets Operator (rotates automatically)
#   → HashiCorp Vault (self-hosted, fine-grained access control)
#   → K8s Secrets with envelope encryption using AWS KMS
# ─────────────────────────────────────────────────────────────────────────────
