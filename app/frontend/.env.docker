# ─────────────────────────────────────────────────────────────────────────────
# Frontend Docker Compose Build Arguments
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT: React environment variables are BUILD-TIME, not runtime.
# They are baked into the JavaScript bundle during `npm run build`.
#
# For Docker Compose, we pass these as build ARGs in docker-compose.yml.
# The Dockerfile uses: ARG REACT_APP_BACKEND_URL
#                      ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
#
# Why localhost:5000 (not backend:5000)?
# ─────────────────────────────────────────
# The React JavaScript bundle runs IN THE USER'S BROWSER, not inside Docker.
# When the browser makes API calls, it cannot resolve "backend" (Docker DNS).
# "backend" only works inside the Docker network, not from the host machine.
#
# So the frontend must use the HOST-accessible URL: http://localhost:5000
#
# Traffic flow in Docker Compose:
#   Browser (host) → http://localhost:5000/api/tasks
#                  → Docker port mapping 5000:5000
#                  → backend container:5000
#
# Traffic flow in Kubernetes (EKS):
#   Browser → https://myapp.example.com/api/tasks
#           → ALB → /api/* rule → backend-service (ClusterIP)
#           → backend pod:5000
#
# ─────────────────────────────────────────────────────────────────────────────

REACT_APP_BACKEND_URL=http://localhost:5000/api/tasks
