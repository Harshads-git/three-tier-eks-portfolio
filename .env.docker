# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — Docker Compose Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# This file is used as a reference for the environment values passed to
# docker-compose.yml services. The values are declared inline in compose
# but documented here for clarity and local override support.
#
# HOW TO USE:
# -----------
# Option A (default — values in docker-compose.yml):
#   docker compose up --build -d
#   Values are hardcoded in docker-compose.yml 'environment' blocks.
#
# Option B (override with this file):
#   docker compose --env-file .env.docker up -d
#   Docker Compose substitutes ${VARIABLE} references from this file.
#
# ⚠️  This file is committed because it contains only LOCAL DEV values.
#     No real secrets here — MongoDB credentials are dev-only placeholders.
#     For production, these are replaced by K8s Secrets and ConfigMaps.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# DOCKER COMPOSE SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Project name — prefix for all container/volume/network names
COMPOSE_PROJECT_NAME=three-tier-eks-portfolio

# ─────────────────────────────────────────────────────────────────────────────
# MONGODB SERVICE
# ─────────────────────────────────────────────────────────────────────────────
MONGO_IMAGE=mongo:6.0
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DATABASE=tasksdb
MONGO_HOST_PORT=27017

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND SERVICE
# ─────────────────────────────────────────────────────────────────────────────
# MONGO_URI uses 'mongo' as hostname (Docker internal DNS service name)
# K8s equivalent: mongo-service.three-tier.svc.cluster.local
BACKEND_PORT=5000
BACKEND_NODE_ENV=development
MONGO_URI=mongodb://admin:password123@mongo:27017/tasksdb?authSource=admin

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND SERVICE
# ─────────────────────────────────────────────────────────────────────────────
# REACT_APP_BACKEND_URL is a Docker build ARG (build-time, not runtime).
# It gets baked into the React JS bundle during 'npm run build' in the Dockerfile.
# For local Docker Compose, we point directly to localhost:5000 since the
# browser accesses the backend from the host machine (not from inside Docker).
REACT_APP_BACKEND_URL=http://localhost:5000/api/tasks
FRONTEND_HOST_PORT=3000
